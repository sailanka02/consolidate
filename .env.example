# Copy to .env.local for local development, or enter these in Railway's Variables tab for the demo deployment.
# Placeholders only: NEVER commit real values. .env* is git-ignored (except this file).

# ---------------------------------------------------------------- required in production
# Production refuses to start with MODEL_PROVIDER=claude-code (the local Claude Code CLI cannot run on a server).
MODEL_PROVIDER=anthropic-api
# Server-side only. Enter it directly in Railway. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_UTILITY_MODEL=claude-haiku-4-5

# SQLite file. On Railway this MUST be inside the persistent volume mounted at /data.
CONSOLIDATE_DB_PATH=/data/consolidate.db

# The one shared demo password (at least 8 characters). Choose it yourself in Railway; visitors type it on the login screen.
CONSOLIDATE_DEMO_PASSWORD=

# ---------------------------------------------------------------- safety switches
# Developer controls (failure injection). Honoured ONLY when NODE_ENV is not "production", so this is inert on Railway.
CONSOLIDATE_DEV_TOOLS=0

# Cost-aware fast path: optimize a request only when its expected input savings are at least margin x the cost of validating it.
# 1.5 is the default; 0 always optimizes.
CONSOLIDATE_ECONOMICS_MARGIN=1.5

# ---------------------------------------------------------------- optional tuning (defaults shown)
# Largest request (provider-counted tokens) allowed to reach the model. Bigger requests are refused before any paid
# generation; nothing is truncated. This does NOT replace an Anthropic spend limit: set one in the Anthropic Console too.
# CONSOLIDATE_MAX_REQUEST_TOKENS=100000
# Model-spending rate limits (in-memory, one instance).
# CONSOLIDATE_CHAT_LIMIT_PER_10_MIN=20        messages per visitor per 10 minutes
# CONSOLIDATE_CHAT_LIMIT_PER_HOUR=120         messages per hour across the whole demo
# CONSOLIDATE_BENCHMARK_LIMIT_PER_HOUR=3      benchmark runs per visitor per hour (2x that across the whole demo)
# Login session length in hours, and an optional separate key for signing session cookies (otherwise derived from the password).
# CONSOLIDATE_SESSION_HOURS=12
# CONSOLIDATE_SESSION_SECRET=
# Escape hatch: allow the database outside a Railway volume (DATA IS LOST ON EVERY DEPLOY). Leave unset.
# CONSOLIDATE_ALLOW_EPHEMERAL_DB=1

# ---------------------------------------------------------------- local development only
# MODEL_PROVIDER=claude-code uses your local Claude Code CLI:
# CLAUDE_BIN=claude
# CLAUDE_CODE_MODEL=
# Require a password locally too (auth is always on in production, optional in development):
# CONSOLIDATE_DEMO_PASSWORD=local-test-password
