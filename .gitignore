# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# consolidate local database
/.consolidate/

# local analysis/replay output: SQLite files here contain real conversation data
/scratchpad/

# any SQLite database, its WAL/shm sidecars, and backups: conversation data must never reach GitHub
*.db
*.db-wal
*.db-shm
*.db-journal
!/demo-data/demos.db
/backups/

# generated demo metrics and seed database
/demo-exports/
